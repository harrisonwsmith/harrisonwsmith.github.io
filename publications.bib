% Publications
%
% To add papers in bulk:
%   1. Go to your Google Scholar profile
%   2. Select the checkbox at the top of the publication list ("Select all")
%   3. Click EXPORT > BibTeX
%   4. Paste the entries into this file
%
% Scholar's export is messy. Check every entry for:
%   - Author names in "Last, First" form, separated by " and "
%   - Correct journal name in {} (Scholar abbreviates inconsistently)
%   - A doi field, which is what makes the rendered link work
%   - Double braces around the WHOLE title: title = {{Your title here}}
%     APA sentence-cases titles, which mangles acronyms and any word after a
%     period ("U.S. maize" becomes "U.S. Maize"). Double braces preserve your
%     capitalization exactly, so write the title in sentence case yourself.
%
% Order in this file does not matter. The page sorts by the CSL style.
% ---------------------------------------------------------------------------

@article{smith2026harvesting,
  author  = {Smith, Harrison W. and Heffernan, Christopher J. and Ashworth, Amanda J. and Nalley, L. Lanier and Bullock, David S. and Tullis, Jason and Owens, Phillip R.},
  title   = {{Harvesting insights: interpretable machine learning to understand environmental drivers of U.S. maize and soybean yield}},
  journal = {Scientific Reports},
  year    = {2026},
  volume  = {16},
  number  = {8994},
  doi     = {10.1038/s41598-026-38724-z}
}

